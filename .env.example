# ── Servidor ─────────────────────────────────────────────
PORT=8787
# URL pública con la que los clientes abren la tienda (sin diagonal final).
# Se usa para las URLs de regreso y notificaciones de Mercado Pago y para el QR.
PUBLIC_URL=http://localhost:8787
# Base de datos: Supabase (Postgres).
# DATABASE_URL → rol de mínimo privilegio fresia_office_app. Lo genera `npm run db:setup`.
#   Es la ÚNICA credencial de base de datos que va en el hosting.
DATABASE_URL=
# Usuario administrador (postgres), solo en tu computadora para `npm run db:migrate|setup|check`.
#   Supabase → Connect → Session pooler. Nunca lo pongas en el hosting.
#   (También se acepta el nombre SESSION_POOLER.)
DATABASE_ADMIN_URL=
# Para `npm run db:check`: comprueba que la API pública no exponga el esquema office.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Sin DATABASE_URL (solo desarrollo/demostración) se usa un Postgres embebido aquí:
PGLITE_PATH=./data/pglite

# ── Panel de administración ──────────────────────────────
# Obligatoria. Usa una contraseña larga y única.
ADMIN_PASSWORD=
# Secreto para firmar la sesión del panel (32+ caracteres aleatorios).
SESSION_SECRET=

# ── Mercado Pago Checkout Pro ────────────────────────────
# Sin MP_ACCESS_TOKEN la tienda funciona en modo demostración (sin cobros).
# Panel de desarrolladores → Tus integraciones → Credenciales de producción.
MP_ACCESS_TOKEN=
# Webhooks → "Clave secreta" para validar la firma x-signature.
MP_WEBHOOK_SECRET=

# ── Aviso automático de pedidos (opcional) ───────────────
# Recibe un POST JSON cada vez que un pedido se paga o pide cotización de envío
# (p. ej. un flujo de Make/Zapier/Slack o un servicio de WhatsApp Business).
NOTIFY_WEBHOOK_URL=
